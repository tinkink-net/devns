{
  "name": "devns",
  "version": "1.0.0",
  "description": "Lightweight UDP DNS resolver proxy using Node.js built-in dns and dns-packet",
  "bin": {
    "devns": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "keywords": [
    "dns",
    "server",
    "udp",
    "resolver",
    "proxy",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dns-packet": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.76",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
